# Use only a verified, isolated Q7 staging project. Never copy production secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required only for entitlement-gated media delivery.
SUPABASE_SERVICE_ROLE_KEY=
FARMAKON_DEPLOY_ENV=staging
# Exact 20-character project ref; must match the URL above before any writes/media.
FARMAKON_STAGING_PROJECT_REF=
FARMAKON_OWNER_WRITES_ENABLED=false
FARMAKON_STUDY_WRITES_ENABLED=false
